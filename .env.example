# EmailJS Configuration (für Kontaktformular und Newsletter)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_NEWSLETTER_TEMPLATE_ID=your_newsletter_template_id
VITE_EMAILJS_UNSUBSCRIBE_TEMPLATE_ID=your_unsubscribe_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Google Apps Script URL (NICHT im Frontend exponiert - nur für Vercel Proxy)
# Diese Variable wird NUR serverseitig im Vercel API-Proxy verwendet
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Development: Live API nutzen (optional)
# VITE_USE_LIVE_API=true
