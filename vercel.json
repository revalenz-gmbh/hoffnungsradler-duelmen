{
  "rewrites": [
    {
      "source": "/api/anmelden",
      "destination": "https://spenden.hoffnungs-radler-duelmen.de/api/anmelden"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/buchhaltung.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
