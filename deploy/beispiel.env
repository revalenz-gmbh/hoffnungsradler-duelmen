# Vorlage für /etc/hoffnungsradler/<instanz>.env  (Rechte: root:hoffnungsradler 640)
# Werte NICHT ins Repo schreiben. Die echten Werte stehen heute in den
# Vercel-Umgebungsvariablen des Projekts (Martin kann sie dort ablesen).

# Welcher Branch auf dieser Instanz läuft
BRANCH=main
# Port des Node-Servers (live z. B. 3000, vorschau 3001; Rauchtest nutzt PORT+100)
PORT=3000
# Nur auf der Vorschau-Instanz: Suchmaschinen aussperren
# VORSCHAU=1

# Server (api/)
SPENDENSTAND_URL=
GOOGLE_APPS_SCRIPT_URL=
# BUCHHALTUNG_FETCH_TIMEOUT_MS=55000

# Build (werden ins öffentliche JavaScript geschrieben, sind also nicht geheim)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_NEWSLETTER_TEMPLATE_ID=
VITE_EMAILJS_UNSUBSCRIBE_TEMPLATE_ID=
